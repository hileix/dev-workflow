{
  "name": "dev-workflow",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "electron/main.mjs",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "chat": "node chat.mjs",
    "server": "node server.mjs",
    "dev:renderer": "pnpm --dir renderer dev --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electronmon .",
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "electron": "pnpm build && electron .",
    "build": "pnpm --dir renderer build",
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.126",
    "@openai/codex": "^0.128.0",
    "@openai/codex-sdk": "^0.128.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "multer": "^2.1.1",
    "ws": "^8.20.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electronmon": "^2.0.4",
    "wait-on": "^9.0.5"
  }
}

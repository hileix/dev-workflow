{
  "id": "dev-workflow-demo",
  "name": "Dev Workflow Demo",
  "version": 1,
  "agents": {
    "planner": {
      "backend": "fake-planner",
      "skill": "plan",
      "contextKey": "plannerMessages"
    },
    "coder": {
      "backend": "fake-coder",
      "skill": "implement",
      "contextKey": "coderMessages"
    }
  },
  "contextGroups": [
    {
      "id": "coding",
      "agent": "coder",
      "sharedSession": true
    }
  ],
  "steps": [
    {
      "id": "plan",
      "type": "agent",
      "agent": "planner",
      "output": {
        "filename": "plan.md"
      },
      "next": "review"
    },
    {
      "id": "review",
      "type": "checkpoint",
      "question": "Approve this plan?",
      "approve": "implement",
      "rejectTo": "plan"
    },
    {
      "id": "implement",
      "type": "agent",
      "contextGroup": "coding",
      "output": {
        "filename": "implementation.md"
      },
      "next": "verify"
    },
    {
      "id": "verify",
      "type": "agent",
      "contextGroup": "coding",
      "output": {
        "filename": "verification.md"
      },
      "next": "finish"
    },
    {
      "id": "finish",
      "type": "end"
    }
  ]
}
